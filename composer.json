{
  "name": "modethirteen/xarray",
  "description": "A utility for traversing PHP arrays with an XPath-like syntax",
  "type": "library",
  "license": "Apache-2.0",
  "authors" : [
    {
      "name": "James Andrew Vaughn",
      "email": "jamesvaughn@modethirteen.com",
      "role": "maintainer"
    }
  ],
  "support": {
    "issues": "https://github.com/MindTouch/XArray/issues"
  },
  "require": {
    "php": "~8.1.12",
    "ext-json": "*",
    "modethirteen/type-ex": "dev-main-php8"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.9.3",
    "phpunit/phpunit": "~9.4.3",
    "rector/rector": "^0.15.1"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/MindTouch/TypeEx",
      "no-api": true
    }
  ],
  "autoload": {
    "psr-4": {
      "modethirteen\\XArray\\": ["src/"]
    }
  },
  "autoload-dev": {
    "psr-4": {
      "modethirteen\\XArray\\Tests\\": ["tests/"]
    }
  }
}
